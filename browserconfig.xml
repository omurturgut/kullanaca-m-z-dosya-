<?xml version="1.0" encoding="utf-8"?>
<!-- browserconfig.xml for Windows Metro Tiles -->
<browserconfig>
  <msapplication>
    <tile>
      <square70x70logo src="/images/tile-70x70.png"/>
      <square150x150logo src="/images/tile-150x150.png"/>
      <wide310x150logo src="/images/tile-310x150.png"/>
      <square310x310logo src="/images/tile-310x310.png"/>
      <TileColor>#0a0a0a</TileColor>
    </tile>
    <notification>
      <polling-uri src="https://posthumane.com/notifications/tile1.xml"/>
      <polling-uri2 src="https://posthumane.com/notifications/tile2.xml"/>
      <polling-uri3 src="https://posthumane.com/notifications/tile3.xml"/>
      <polling-uri4 src="https://posthumane.com/notifications/tile4.xml"/>
      <polling-uri5 src="https://posthumane.com/notifications/tile5.xml"/>
      <frequency>30</frequency>
      <cycle>1</cycle>
    </notification>
  </msapplication>
</browserconfig>
